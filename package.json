{
  "name": "stillhunter",
  "version": "0.2.3",
  "description": "Hunts bugs in a web app change the way a careful QA engineer would, and reports only bugs it has made happen twice in a real browser.",
  "license": "MIT",
  "keywords": [
    "testing",
    "bug-hunting",
    "playwright",
    "fault-injection",
    "claude-code",
    "claude-code-plugin"
  ],
  "homepage": "https://github.com/stillhunter/stillhunter#readme",
  "bugs": {
    "url": "https://github.com/stillhunter/stillhunter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stillhunter/stillhunter.git"
  },
  "type": "module",
  "bin": {
    "stillhunter": "dist/hunt.mjs"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    ".claude-plugin/plugin.json",
    "skills/",
    "agents/",
    "hooks/",
    "dist/",
    "README.md",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"test/*.test.mjs\"",
    "bench": "node benchmark/bench/cli.mts",
    "bench:check": "tsc -p benchmark/bench/tsconfig.json",
    "bench:test": "node --test \"benchmark/bench/test/*.test.mts\""
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
